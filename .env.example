PORT=3000
# Local SQLite by default. For Turso, set libsql://... and the server-only token.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=
# Exact GitHub Pages origin (no repository path), e.g. https://username.github.io
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173
# Set only if your hosting provider has exactly one trusted reverse proxy.
TRUST_PROXY_HOPS=0
# Public API origin compiled into the React app for GitHub Pages. Leave empty locally.
VITE_API_URL=
# Server-side operator allowlist: comma-separated user UUIDs. Never expose as VITE_ variables.
ADMIN_USER_IDS=
